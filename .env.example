# 星座仿真平台 - 环境变量示例
# 复制为 .env 并按需修改（所有变量均提供默认值，可留空）。

# ---- 服务 ----
HOST=0.0.0.0
PORT=8080

# ---- 数据 ----
# DATA_DIR=/workspace/data
# SQLITE_PATH=/workspace/data/constellation.db

# ---- celestrak 持续拉取 ----
# 是否启用 celestrak 持续拉取（默认 false：使用基于真实星座设计参数的合成轨道根数兜底）
CELESTRAK_ENABLED=false
# 拉取周期（秒）
CELESTRAK_FETCH_INTERVAL=7200
# 单次请求超时（秒）
CELESTRAK_TIMEOUT=20

# ---- 仿真默认参数 ----
DEFAULT_SAMPLE_INTERVAL_S=15
DEFAULT_DURATION_H=24
DEFAULT_EL_MIN_DEG=10
DEFAULT_C_MIN_DBM=-100
DEFAULT_H3_RES=4
DEFAULT_FREQ_HZ=12000000000
DEFAULT_BANDWIDTH_HZ=30000000
DEFAULT_EIRP_DBW=47
DEFAULT_G_R_DBI=3
DEFAULT_T_S_K=300
DEFAULT_L_ATM_DB=2
DEFAULT_L_POL_DB=0.5
DEFAULT_L_POINT_DB=0.5

# 默认地面区域包围盒 [lat_min, lon_min, lat_max, lon_max]
# DEFAULT_REGION=18,73,54,135
